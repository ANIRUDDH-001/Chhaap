# Windows local setup generates random credentials automatically. Never commit .env.
DATABASE_ADMIN_URL=postgresql+psycopg://chhaap_admin:CHANGE_ME_ADMIN@127.0.0.1:55432/chhaap
DATABASE_URL=postgresql+psycopg://chhaap_app:CHANGE_ME_APP@127.0.0.1:55432/chhaap
TEST_DATABASE_URL=postgresql+psycopg://chhaap_app:CHANGE_ME_APP@127.0.0.1:55432/chhaap_test
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=gemma4:e4b
FRONTEND_ORIGIN=http://localhost:5175
COOKIE_SECURE=false
# DATA_DIR defaults to the repository's ignored .data/media directory.
# Docker Compose additionally needs strong POSTGRES_PASSWORD and APP_DB_PASSWORD.
